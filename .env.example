# Copy this file to .env and fill in your values. .env is git-ignored and never baked into images.

# --- Providers: gemini (cloud) | local (llama.cpp on your GPU) ---
LLM_PROVIDER=local
EMBED_PROVIDER=local
# Embedding size. Leave unset for the provider default (local 1024, gemini 768).
# Changing provider or size needs a fresh graph (UI -> Reset graph).
# EMBED_DIM=1024

# --- Gemini (only needed if a provider above is "gemini") ---
GEMINI_API_KEY=PUT_YOUR_KEY_HERE
GEMINI_LLM_MODEL=gemini-3.8-flash
GEMINI_EMBED_MODEL=gemini-embedding-001

# --- Local models (downloaded once into the Docker volume graphrag_models) ---
# Default: Qwen3.5-9B, fits fully in 16 GB VRAM (fast, validated).
# Bigger option (needs 16 GB VRAM + 32 GB RAM, slower): unsloth/Qwen3.6-35B-A3B-GGUF / Qwen3.6-35B-A3B-UD-Q4_K_XL.gguf
LOCAL_LLM_REPO=unsloth/Qwen3.5-9B-GGUF
LOCAL_LLM_FILE=Qwen3.5-9B-UD-Q4_K_XL.gguf
LOCAL_EMBED_REPO=Qwen/Qwen3-Embedding-0.6B-GGUF
LOCAL_EMBED_FILE=Qwen3-Embedding-0.6B-Q8_0.gguf
# LOCAL_LLM_CTX=65536              # total context shared by the LLM_CONCURRENCY slots
# LOCAL_FIT_TARGET_MB=1024         # VRAM (MiB) llama.cpp keeps free when auto-fitting
# LOCAL_LLAMA_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda
# LOCAL_UBATCH=2048                # prompt batch size (bigger = faster prompt processing for MoE with CPU experts)
# LOCAL_LOAD_MODE=auto             # auto (mmap) | none (load into RAM: faster generation, needs .wslconfig memory=24GB)

# --- Neo4j ---
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-please
NEO4J_HEAP=2G
NEO4J_PAGECACHE=1G

# --- App ---
APP_PORT=8000

# --- Optional tuning (defaults shown; uncomment to change) ---
# GEMINI_THINKING_LEVEL=low        # low | medium | high
# LLM_CONCURRENCY=2                # parallel LLM calls (gemini free tier: 1-2; local: llama.cpp slots)
# LLM_RPM=10                       # max generate requests per minute (gemini only)
# EMBED_RPM=60                     # max embedding requests per minute (gemini only)
# CHUNK_SIZE_CHARS=4000            # ~1000 tokens per chunk
# CHUNK_OVERLAP_CHARS=400
# ER_COSINE_THRESHOLD=             # duplicate-candidate similarity (default: gemini 0.85, local 0.70)
# ER_TOP_K=5
# LEIDEN_MAX_LEVELS=10
# LEIDEN_GAMMA=1.0                 # higher = smaller, more numerous communities
# RETRIEVAL_THRESHOLD=             # query vs summary similarity to accept / descend (default: gemini 0.55, local 0.50)
# RETRIEVAL_TOP_K=6                # max top-level communities to start from
# CONTEXT_MAX_CHARS=30000          # context budget sent to the LLM
# MAX_SOURCE_CHUNKS=6              # source-text excerpts in the context
